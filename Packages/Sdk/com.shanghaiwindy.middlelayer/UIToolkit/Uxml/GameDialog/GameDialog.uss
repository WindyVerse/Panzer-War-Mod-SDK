/* GameDialog.uss — layout & sizing only, appearance from GameTheme.uss */

.gd-message {
    font-size: 24px;
    color: rgba(200, 200, 210, 0.7);
    white-space: normal;
    margin-bottom: 16px;
}

.gd-input {
    min-height: 64px;
    margin-bottom: 20px;
}

.gd-input .unity-label {
    display: none;
}

.gd-actions {
    flex-direction: row;
    justify-content: flex-end;
}

.gd-btn {
    height: 64px;
    min-width: 80px;
    padding-left: 16px;
    padding-right: 16px;
    margin-left: 10px;
    font-size: 24px;
}

/* Toast */
.gd-toast {
    position: absolute;
    top: 100px;
    align-self: center;
    max-width: 70%;
    padding: 12px 28px;
    background-color: rgba(20, 20, 26, 0.88);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(140, 140, 150, 0.1);
}

.gd-toast-text {
    font-size: 24px;
    color: rgba(210, 210, 220, 0.9);
    white-space: normal;
    -unity-text-align: upper-center;
}
