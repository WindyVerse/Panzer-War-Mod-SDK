<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="../GameTheme.uss" />
    <Style src="GameDialog.uss" />
    <ui:VisualElement name="gen_Overlay" class="g-dialog-overlay" style="display: none;">
        <ui:VisualElement class="g-dialog">
            <ui:Label name="gen_TitleLabel" class="g-dialog-title" />
            <ui:Label name="gen_MessageLabel" class="gd-message" />
            <ui:TextField name="gen_InputField" class="gd-input g-textfield" />
            <ui:VisualElement class="gd-actions">
                <ui:Button name="gen_CancelButton" class="gd-btn g-btn-ghost" />
                <ui:Button name="gen_ConfirmButton" class="gd-btn g-btn-gold" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Toast notice (bottom-center, auto-dismiss) -->
    <ui:VisualElement name="gen_Toast" picking-mode="Ignore" class="gd-toast" style="display: none;">
        <ui:Label name="gen_ToastLabel" class="gd-toast-text" />
    </ui:VisualElement>
</ui:UXML>
