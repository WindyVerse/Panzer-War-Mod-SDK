/* ================================================================
   LoadingPanel.uss — Full-screen loading overlay with spinner
   ================================================================ */

.ld-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

/* ================== Background ================== */

.ld-bg {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-image: url("../../Icons/LoadingMain.jpg");
    -unity-background-scale-mode: scale-and-crop;
}

.ld-bg-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.82);
}

/* ================== Center Content ================== */

.ld-center {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

/* ================== Spinner ================== */

.ld-spinner {
    width: 48px;
    height: 48px;
    margin-bottom: 20px;
}

.ld-spinner-arc {
    width: 48px;
    height: 48px;
    border-width: 3px;
    border-color: rgba(140, 140, 150, 0.1);
    border-top-color: rgb(198, 158, 59);
    border-radius: 24px;
}

/* ================== Text Labels ================== */

.ld-status {
    font-size: 22px;
    color: rgba(220, 220, 230, 0.85);
    letter-spacing: 1px;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 80%;
}

.ld-detail {
    font-size: 16px;
    color: rgba(180, 180, 190, 0.5);
    -unity-text-align: middle-center;
    margin-bottom: 24px;
    white-space: normal;
    max-width: 80%;
}

.ld-advice {
    font-size: 18px;
    color: rgba(200, 200, 210, 0.35);
    -unity-text-align: middle-center;
    -unity-font-style: normal;
    white-space: normal;
    max-width: 70%;
    margin-bottom: 16px;
    transition: opacity 0.6s ease-in-out;
}

.ld-log {
    position: absolute;
    left: 16px;
    bottom: 16px;
    font-size: 12px;
    color: rgba(160, 160, 170, 0.5);
    -unity-text-align: upper-left;
    white-space: normal;
    max-width: 60%;
    max-height: 120px;
    overflow: hidden;
}
